# MONGODB_URI: Required in production (Vercel) for persistent MongoDB storage via Mongoose.
# In local development, if unset or unreachable, the app falls back to data/smartcampus.json.
MONGODB_URI=""

# JWT_SECRET: Required in production (Vercel) for signing and verifying authentication JWTs.
# Use a long random string (e.g., 32+ characters). Never commit real secrets.
JWT_SECRET="smart_campus_dev_jwt_secret_change_in_production"

# GEMINI_API_KEY: Optional server-side Gemini API key (only needed if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where the app is hosted (optional metadata/callback reference).
APP_URL="MY_APP_URL"
